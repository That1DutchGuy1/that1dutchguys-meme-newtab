{
  "manifest_version": 3,
  "name": "That1DutchGuy's Meme New Tab",
  "version": "3.1",
  "description": "Mah boi, this new tab extension is what all true memers strive for!",

  "chrome_url_overrides": {
    "newtab": "chromium-memetab.html"
  },

  "icons": {
    "48": "icons/icon.png"
  },

  "permissions": [
    "storage",
    "geolocation"
  ],

  "host_permissions": [
    "https://api.open-meteo.com/",
    "https://nominatim.openstreetmap.org/",
    "https://www.google.com/s2/favicons*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/*"
  ]
}